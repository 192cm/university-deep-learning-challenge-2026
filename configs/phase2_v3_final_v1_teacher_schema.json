{
  "type": "json_schema",
  "name": "phase2_verified_cot_integer_v3_final_v1",
  "strict": true,
  "schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": ["solved", "unsuitable"]
      },
      "issue_type": {
        "type": "string",
        "enum": [
          "none",
          "multiple_outputs",
          "underdetermined",
          "non_integer_answer",
          "non_numeric_answer",
          "ambiguous",
          "other"
        ]
      },
      "solution": {
        "type": "string",
        "description": "A concise, explicit, self-contained solution visible to a student."
      },
      "final_answer": {
        "type": "string",
        "description": "For solved responses, exactly one canonical base-10 integer string. Empty for unsuitable responses."
      },
      "unit_check": {
        "type": "string",
        "description": "A short units check, or a statement that the answer is dimensionless."
      },
      "self_check": {
        "type": "string",
        "description": "A short independent verification."
      }
    },
    "required": [
      "status",
      "issue_type",
      "solution",
      "final_answer",
      "unit_check",
      "self_check"
    ],
    "additionalProperties": false
  }
}
